# Discord bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Your application (client) ID, from the app's "General Information" page.
# Needed to register slash commands.
DISCORD_CLIENT_ID=your-application-id-here

# Optional: a single guild (server) ID to register commands to instantly during development.
# Leave empty to register commands globally (can take up to ~1 hour to appear).
DISCORD_GUILD_ID=
