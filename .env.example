# shortcaller needs TWO bot applications, because a single Discord bot can only
# be connected to one voice channel per server. Bot A sits in Group A's voice
# channel, Bot B sits in Group B's. Create both at:
#   https://discord.com/developers/applications
# and invite BOTH to your server.

# --- Bot A (Group A) — also hosts the slash commands ---
DISCORD_TOKEN_A=bot-a-token-here
DISCORD_CLIENT_ID_A=bot-a-application-id-here

# --- Bot B (Group B) ---
DISCORD_TOKEN_B=bot-b-token-here

# The server (guild) ID where the rooms live. Used to register slash commands
# instantly. Enable Developer Mode in Discord, right-click the server -> Copy ID.
DISCORD_GUILD_ID=your-guild-id-here
